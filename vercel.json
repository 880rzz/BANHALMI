{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/oneletrajz-cv-fotozas",
      "destination": "/hu/portre/",
      "permanent": true
    },
    {
      "source": "/portfolio-fotozas",
      "destination": "/hu/portre/",
      "permanent": true
    },
    {
      "source": "/muveszi-aktfotozas",
      "destination": "/hu/muveszi-fotografia/",
      "permanent": true
    },
    {
      "source": "/reklam-fotozas",
      "destination": "/hu/brand/",
      "permanent": true
    },
    {
      "source": "/post/amikor-csak-egy-táncpartnered-van-egész-estére",
      "destination": "https://blog.banhalmi.art/post/amikor-csak-egy-táncpartnered-van-egész-estére",
      "permanent": true
    },
    {
      "source": "/blog/tags/filter-nélkül-a-testem-története",
      "destination": "https://blog.banhalmi.art/blog/tags/nofilter",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://www.norbertbanhalmi.com/de-at/:path*",
      "permanent": true,
      "has": [{"type":"header","key":"Host","value":"banhalmi.at"}]
    },
    {
      "source": "/:path*",
      "destination": "https://www.norbertbanhalmi.com/de-at/:path*",
      "permanent": true,
      "has": [{"type":"header","key":"Host","value":"www.banhalmi.at"}]
    },
    {
      "source": "/:path*",
      "destination": "https://www.norbertbanhalmi.com/hu/:path*",
      "permanent": true,
      "has": [{"type":"header","key":"Host","value":"banhalminorbert.hu"}]
    },
    {
      "source": "/:path*",
      "destination": "https://www.norbertbanhalmi.com/hu/:path*",
      "permanent": true,
      "has": [{"type":"header","key":"Host","value":"www.banhalminorbert.hu"}]
    },
    {
      "source": "/",
      "destination": "/index.html",
      "permanent": false,
      "has": [{"type":"header","key":"referer","value":"^https://www\\.norbertbanhalmi\\.com/hu/.*"}]
    },
    {
      "source": "/",
      "destination": "/index.html",
      "permanent": false,
      "has": [{"type":"header","key":"referer","value":"^https://www\\.norbertbanhalmi\\.com/de-at/.*"}]
    },
    {
      "source": "/",
      "destination": "/hu/",
      "permanent": false,
      "has": [{"type":"header","key":"accept-language","value":"^hu.*"}]
    },
    {
      "source": "/",
      "destination": "/de-at/",
      "permanent": false,
      "has": [{"type":"header","key":"accept-language","value":"^de.*"}]
    }
  ]
}
