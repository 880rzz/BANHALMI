      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Understand",
          "text": "Understand the organisation, its goals, culture, audiences, leadership and business situations."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Position",
          "text": "Define the leadership presence and visual principles that communicate trust, credibility and professionalism."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Create",
          "text": "Produce executive portraits, brand photography, employer-branding imagery and C-Level event documentation as one coherent system."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Roll out",
          "text": "Adapt the visual system for LinkedIn, websites, press, presentations, recruitment, campaigns and international business communication."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Evolve",
          "text": "Maintain and develop the visual language as leadership, teams and communication needs change."
        }
      ]
    },
